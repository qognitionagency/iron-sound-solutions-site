---
/** Composes sections only. No copy, no logic (ADR §2). */
import Base from '../layouts/Base.astro';
import Nav from '../components/sections/Nav.astro';
import Hero from '../components/sections/Hero.astro';
import Partners from '../components/sections/Partners.astro';
import Services from '../components/sections/Services.astro';
import Lighting from '../components/sections/Lighting.astro';
import Sectors from '../components/sections/Sectors.astro';
import Process from '../components/sections/Process.astro';
import Gallery from '../components/sections/Gallery.astro';
import Testimonials from '../components/sections/Testimonials.astro';
import ServiceArea from '../components/sections/ServiceArea.astro';
import Faq from '../components/sections/Faq.astro';
import Consult from '../components/sections/Consult.astro';
import Footer from '../components/sections/Footer.astro';
import MobileBar from '../components/sections/MobileBar.astro';
import Band from '../components/ui/Band.astro';
---
<Base>
  <Nav />
  <main id="main">
    <Hero />
    <Partners />
    <Services />
    <Lighting />
    <Band back="band-pool" front="band-control" side="right" />
    <Sectors />
    <Process />
    <Band back="band-yacht" front="band-cinema" side="left" />
    <Gallery />
    <Testimonials />
    <ServiceArea />
    <Faq />
    <Consult />
  </main>
  <Footer />
  <MobileBar />
</Base>
