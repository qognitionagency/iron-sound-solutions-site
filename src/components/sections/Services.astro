---
import { services } from '../../data/content';
import Img from '../ui/Img.astro';
import Button from '../ui/Button.astro';
import SectionHead from '../ui/SectionHead.astro';

// Reading order matches the desktop grid: large, small, small / large, small, small.
const larges = services.tiles.filter((t) => t.size === 'large');
const smalls = services.tiles.filter((t) => t.size === 'small');
const tiles = [larges[0], smalls[0], smalls[1], larges[1], smalls[2], smalls[3]].filter((t) => t !== undefined);
---
<section id="services" class="section services" aria-labelledby="services-heading">
  <div class="frame">
    <SectionHead display={services.display} heading={services.heading} id="services-heading">
      <Button cta={services.cta} location="services" magnetic />
    </SectionHead>

    <ul class="bento" role="list" data-reveal-stagger>
      {tiles.map((t) => (
        <li class:list={['tile', `tile--${t.size}`]} data-glow data-reveal>
          <div class="tile__media">
            <Img
              slot={t.media.slot}
              alt={t.media.alt}
              ratio={t.size === 'large' ? 4 / 3 : 1}
              quality={60}
              widths={t.size === 'large' ? [480, 720, 960, 1280] : [360, 540, 720]}
              sizes={t.size === 'large' ? '(min-width: 1024px) 46vw, (min-width: 768px) 92vw, 100vw' : '(min-width: 1024px) 23vw, (min-width: 768px) 46vw, 100vw'}
              class="tile__img"
            />
            <span class="tile__glow" aria-hidden="true"></span>
          </div>
          <div class="tile__body">
            <h3 class="tile__h3">{t.heading}</h3>
            <p class="tile__lede">{t.lede}</p>
            <p class="tile__text">{t.body}</p>
            <Button cta={t.link} location="services" variant="text" class="tile__link" />
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .bento {
    display: grid;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .tile {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-xs);
    transition: box-shadow var(--duration-slow) var(--ease-out-quart), border-color var(--duration-slow) var(--ease-out-quart);
  }
  .tile:hover, .tile:focus-within { box-shadow: var(--shadow-glow-dusk); border-color: transparent; }

  .tile__media {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: var(--color-stone-200);
  }
  .tile__media :global(picture), .tile__media :global(.tile__img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .tile__media :global(.tile__img) { transition: transform var(--duration-scene) var(--ease-out-expo); }
  .tile:hover .tile__media :global(.tile__img) { transform: scale(1.04); }

  /* Pool-light glow that follows the cursor (motion.ts sets --mx/--my on fine pointers). */
  .tile__glow {
    position: absolute;
    inset: 0;
    opacity: 0;
    background: radial-gradient(circle at var(--mx, 50%) var(--my, 50%), rgb(142 155 255 / 0.55), rgb(142 155 255 / 0) 45%);
    mix-blend-mode: screen;
    transition: opacity var(--duration-slow) var(--ease-standard);
    pointer-events: none;
  }
  .tile.has-glow:hover .tile__glow { opacity: 1; }

  .tile__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-5);
    border-top: 1px solid var(--color-rule);
  }
  .tile__h3 { margin: 0; font-size: var(--text-xl); }
  .tile__lede { margin: var(--space-1) 0 0; color: var(--color-text); }
  .tile__text { margin: 0; font-size: var(--text-sm); color: var(--color-text-muted); }
  .tile__body :global(.tile__link) { align-self: flex-start; margin-top: auto; padding-top: var(--space-3); }

  @media (min-width: 768px) {
    .bento { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .tile--large { grid-column: span 2; }
    .tile--large .tile__media { aspect-ratio: 16 / 9; }
  }
  @media (min-width: 1280px) {
    .bento { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--space-5); }
    /* Row 1: large + two small. Row 2: two small + large (zigzag). Small tiles go tall to match. */
    .tile--large .tile__media { aspect-ratio: 4 / 3; }
    .tile--small .tile__media { aspect-ratio: auto; flex: 1 1 auto; min-height: 16rem; }
    .tile:nth-child(4) { grid-column: 3 / span 2; grid-row: 2; }
    .tile:nth-child(5) { grid-column: 1; grid-row: 2; }
    .tile:nth-child(6) { grid-column: 2; grid-row: 2; }
  }
</style>
