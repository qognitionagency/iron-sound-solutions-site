---
/**
 * Sticky Book / Call bar (<768px, operator ruling). Fixed, so it never shifts
 * layout. With JS it appears once the hero has left the viewport and steps
 * aside while the consultation form is in view (cro-spec §2). Without JS it
 * simply stays visible.
 */
import { stickyBar } from '../../data/content';
import Button from '../ui/Button.astro';
---
<nav class="mbar" aria-label={stickyBar.label} data-mbar>
  <Button cta={stickyBar.call} location="mobilebar" variant="secondary" class="mbar__btn" />
  <Button cta={{ ...stickyBar.book, ariaLabel: stickyBar.bookAria }} location="mobilebar" class="mbar__btn" />
</nav>

<script>
  const bar = document.querySelector<HTMLElement>('[data-mbar]');
  const hero = document.querySelector('[data-hero]');
  const consult = document.getElementById('consult');
  if (bar && hero) {
    let pastHero = false;
    let atForm = false;
    const sync = () => {
      const show = pastHero && !atForm;
      bar.classList.toggle('is-shown', show);
      bar.inert = !show;
    };
    bar.classList.add('is-js');
    new IntersectionObserver(([e]) => {
      pastHero = !e.isIntersecting;
      sync();
    }, { rootMargin: '-30% 0px 0px 0px' }).observe(hero);
    if (consult) new IntersectionObserver(([e]) => {
      atForm = e.isIntersecting;
      sync();
    }, { rootMargin: '0px 0px -35% 0px' }).observe(consult);
    sync();
  }
</script>

<style>
  .mbar {
    position: fixed;
    inset: auto 0 0 0;
    z-index: var(--z-sticky);
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-gutter) calc(var(--space-3) + env(safe-area-inset-bottom));
    background: var(--color-surface-glass);
    -webkit-backdrop-filter: blur(18px) saturate(1.2);
    backdrop-filter: blur(18px) saturate(1.2);
    border-top: 1px solid var(--color-border-strong);
    transition: transform var(--duration-slow) var(--ease-out-expo), visibility 0s linear var(--duration-slow);
  }
  .mbar.is-js { transform: translateY(110%); visibility: hidden; }
  .mbar.is-js.is-shown { transform: none; visibility: visible; transition: transform var(--duration-slow) var(--ease-out-expo), visibility 0s; }
  .mbar :global(.mbar__btn) { width: 100%; }
  @media (min-width: 768px) { .mbar { display: none; } }
</style>
