---
/** The one deep band (plan: harbor navy, never black). Quotes verbatim, no photos, no stars. */
import { testimonials } from '../../data/content';
import Button from '../ui/Button.astro';
import SectionHead from '../ui/SectionHead.astro';
---
<section id="reviews" class="section reviews on-deep" aria-labelledby="reviews-heading">
  <div class="frame">
    <SectionHead display={testimonials.display} heading={testimonials.heading} id="reviews-heading" tone="deep">
      <Button cta={testimonials.cta} location="testimonials" variant="inverse" magnetic />
    </SectionHead>
    <ul class="quotes" role="list" data-reveal-stagger>
      {testimonials.items.map((t) => (
        <li class="quote" data-reveal>
          {t.moment && <p class="eyebrow quote__moment">{t.moment}</p>}
          <blockquote class="quote__block">
            <p class="quote__text">“{t.quote}”</p>
            <footer class="quote__author">{t.author}</footer>
          </blockquote>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .reviews {
    position: relative;
    isolation: isolate;
    background: var(--color-surface-deep);
    color: var(--color-text-on-deep);
    overflow: hidden;
  }
  /* Pool light under the water line: the one place dusk glows on the deep band. */
  .reviews::before {
    content: "";
    position: absolute;
    z-index: -1;
    left: 50%;
    bottom: -40%;
    width: 120%;
    aspect-ratio: 3 / 1;
    transform: translateX(-50%);
    background: radial-gradient(ellipse at center, rgb(142 155 255 / 0.22), rgb(142 155 255 / 0) 60%);
  }
  .quotes { display: grid; gap: var(--space-5); margin: 0; padding: 0; list-style: none; }
  .quote {
    position: relative;
    display: grid;
    align-content: start;
    gap: var(--space-4);
    padding: var(--space-6);
    border: 1px solid rgb(247 246 242 / 0.14);
    border-top-color: var(--color-brass);
    border-radius: var(--radius-md);
    background: rgb(247 246 242 / 0.04);
  }
  .quote__moment { margin: 0; color: var(--color-stone-200); }
  .quote__block { margin: 0; }
  .quote__text { margin: 0; font-size: var(--text-lg); line-height: 1.55; color: var(--color-stone-50); }
  .quote__author { margin-top: var(--space-5); font-size: var(--text-sm); font-weight: var(--font-weight-label); color: var(--color-stone-200); letter-spacing: 0.04em; }
  @media (max-width: 479px) {
    .quote { padding: var(--space-5); }
    .quote__text { font-size: var(--text-base); }
  }
  @media (min-width: 1024px) {
    .quotes { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-5); }
  }
</style>
