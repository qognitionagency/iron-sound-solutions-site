---
/**
 * Projects. Client photos only (art-direction §5.6); heading switches per
 * content.ts until provenance is confirmed. Each frame clips an over-sized
 * image that drifts on scroll (parallax inside the frame, not the frame).
 */
import { projects } from '../../data/content';
import Img from '../ui/Img.astro';
import Button from '../ui/Button.astro';
import SectionHead from '../ui/SectionHead.astro';

// content.ts item id → media slot (media-manifest.json). The boat deck reuses the Boat panel photo.
const slotFor = (id: string) => (id === 'boat-deck' ? 'env-marine-client' : `gallery-${id}`);
// Crop anchors per frame (sharp gravity). Pendants: keep the top, lose the bags in the foreground.
const anchor: Record<string, string> = { pendants: 'top', camera: 'center' };
---
<section id="work" class="section gallery" aria-labelledby="work-heading">
  <div class="frame">
    <SectionHead display={projects.display} heading={projects.heading} id="work-heading">
      <p>{projects.intro}</p>
    </SectionHead>

    <ul class="grid" role="list">
      {projects.items.map((p) => (
        <li class="item" data-reveal>
          <figure class="item__fig">
            <div class="item__frame">
              <div class="item__plate" data-parallax="6">
                <Img
                  slot={slotFor(p.id)}
                  alt={p.alt}
                  ratio={4 / 3}
                  position={anchor[p.id] ?? 'center'}
                  widths={[480, 720, 960, 1200]}
                  sizes="(min-width: 1024px) 30vw, (min-width: 768px) 46vw, 100vw"
                  class="item__img"
                />
              </div>
            </div>
            <figcaption class="item__cap">
              <h3 class="item__h3">{p.heading}</h3>
              <p class="item__text">{p.caption}</p>
              <p class="item__credit">{p.credit}</p>
            </figcaption>
          </figure>
        </li>
      ))}
    </ul>

    <div class="gallery__cta">
      <Button cta={projects.cta} location="gallery" />
    </div>
  </div>
</section>

<style>
  .gallery { background: var(--color-bg); }
  .grid { display: grid; gap: var(--space-7) var(--space-5); margin: 0; padding: 0; list-style: none; }
  .item__fig { margin: 0; }
  .item__frame {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-sm);
    background: var(--color-stone-200);
  }
  .item__plate { position: absolute; inset: -8% 0; }
  .item__plate :global(picture), .item__plate :global(.item__img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .item__frame :global(.item__img) { transition: transform var(--duration-scene) var(--ease-out-expo); }
  .item:hover .item__frame :global(.item__img) { transform: scale(1.03); }
  .item__cap { display: grid; gap: var(--space-1); padding-top: var(--space-4); border-top: 1px solid transparent; }
  .item__h3 { margin: 0; font-size: var(--text-lg); }
  .item__text { margin: 0; font-size: var(--text-sm); color: var(--color-text-muted); max-width: 44ch; }
  .item__credit { margin: var(--space-1) 0 0; font-size: var(--text-xs); color: var(--color-brass-700); letter-spacing: 0.04em; }
  .gallery__cta { margin-top: var(--space-8); }

  @media (min-width: 768px) {
    .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .item:nth-child(even) { margin-top: var(--space-9); }
  }
  @media (min-width: 1024px) {
    .grid { grid-template-columns: repeat(3, minmax(0, 1fr)); column-gap: var(--space-6); }
    .item:nth-child(even) { margin-top: 0; }
    .item:nth-child(3n + 2) { margin-top: var(--space-9); }
  }
</style>
