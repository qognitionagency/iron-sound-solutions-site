---
/**
 * A group of radio or checkbox "chips" for the consultation form. Native inputs
 * stay in the accessibility tree and keyboard order; the label is the target.
 * `cards` renders larger tiles (step 1) with an optional image per option.
 */
import Img from './Img.astro';

interface Opt { key: string; label: string; marker?: string; image?: string }
interface Props {
  name: string;
  type: 'radio' | 'checkbox';
  options: readonly Opt[];
  required?: boolean;
  variant?: 'chips' | 'cards' | 'list';
  idPrefix: string;
}
const { name, type, options, required = false, variant = 'chips', idPrefix } = Astro.props;
---
<div class:list={['choices', `choices--${variant}`]}>
  {options.map((o) => (
    <label class="choice" for={`${idPrefix}-${o.key}`}>
      <input
        class="choice__input"
        type={type}
        name={name}
        value={o.key}
        id={`${idPrefix}-${o.key}`}
        required={type === 'radio' && required ? true : undefined}
      />
      {o.image && (
        <span class="choice__media" aria-hidden="true">
          <Img slot={o.image} alt="" ratio={4 / 3} widths={[200, 320, 400]} sizes="(min-width: 768px) 12rem, 30vw" class="choice__img" />
        </span>
      )}
      <span class="choice__text">
        <span class="choice__label">{o.label}</span>
        {o.marker && <span class="choice__marker">{o.marker}</span>}
      </span>
      <span class="choice__tick" aria-hidden="true">
        <svg viewBox="0 0 12 12" width="12" height="12"><path d="M2.5 6.2 5 8.6l4.5-5" fill="none" stroke="currentColor" stroke-width="1.6" /></svg>
      </span>
    </label>
  ))}
</div>

<style>
  .choices { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .choices--cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-3); }
  .choices--list { display: grid; gap: var(--space-2); }

  .choice {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 2.75rem;
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    color: var(--color-text);
    font-size: var(--text-sm);
    cursor: pointer;
    transition: border-color var(--duration-fast) var(--ease-standard), background-color var(--duration-fast) var(--ease-standard), box-shadow var(--duration-base) var(--ease-standard);
  }
  .choice:hover { border-color: var(--color-iron-300); }
  .choice__input { position: absolute; opacity: 0; width: 1px; height: 1px; margin: 0; pointer-events: none; }
  .choice:has(.choice__input:focus-visible) { box-shadow: var(--shadow-focus); }
  .choice:has(.choice__input:checked) { border-color: var(--color-iron-700); background: var(--color-iron-50); color: var(--color-heading); }
  .choice__text { display: grid; gap: 2px; }
  .choice__marker { font-size: var(--text-xs); color: var(--color-text-muted); }
  .choice__tick {
    display: grid;
    place-items: center;
    flex: none;
    width: 1.125rem;
    height: 1.125rem;
    margin-left: auto;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-xs);
    color: transparent;
    transition: background-color var(--duration-fast) var(--ease-standard), color var(--duration-fast) var(--ease-standard);
  }
  .choice:has(input[type="radio"]) .choice__tick { border-radius: 50%; }
  .choice:has(.choice__input:checked) .choice__tick { background: var(--color-iron-700); border-color: var(--color-iron-700); color: var(--color-on-accent); }

  .choices--cards .choice {
    flex-direction: column;
    align-items: stretch;
    gap: 0;
    padding: 0;
    overflow: hidden;
  }
  .choice__media { display: block; position: relative; aspect-ratio: 4 / 3; overflow: hidden; background: var(--color-stone-200); }
  .choice__media :global(picture), .choice__media :global(.choice__img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .choices--cards .choice__text { padding: var(--space-3) var(--space-4); font-family: var(--font-display); font-stretch: var(--font-display-stretch); font-weight: var(--font-weight-heading); font-size: var(--text-base); color: var(--color-heading); }
  .choices--cards .choice__tick { position: absolute; top: var(--space-2); right: var(--space-2); background: var(--color-surface); }
  .choices--list .choice { width: 100%; }
  @media (max-width: 479px) {
    .choices--cards { grid-template-columns: 1fr; gap: var(--space-2); }
    .choices--cards .choice { flex-direction: row; align-items: center; }
    .choices--cards .choice__media { width: 5.5rem; flex: none; aspect-ratio: 4 / 3; }
    .choices--cards .choice__tick { position: static; margin-right: var(--space-4); }
  }
</style>
